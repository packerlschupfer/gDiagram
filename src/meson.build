# LSP server sources
lsp_sources = files(
  'lsp/lsp_main.vala',
  'lsp/LspServer.vala',
  'lsp/LspDocumentState.vala',
  'lsp/LspProtocol.vala',
)

# C sources for ABI compatibility (shared by both executables)
c_sources = files(
  'util/graphviz_compat.c',
)

# Shared Vala compiler args
shared_vala_args = [
  '--vapidir=' + meson.project_source_root() / 'vapi',
  '--pkg=graphviz_compat',
]

# Shared C compiler args
shared_c_args = ['-I' + meson.current_source_dir() / 'util'] + (graphviz_size_t ? ['-DGRAPHVIZ_RENDER_DATA_SIZE_T'] : [])

# GUI application resources
resources = gnome.compile_resources(
  'gdiagram-resources',
  join_paths(meson.project_source_root(), 'data', 'org.gnome.gDiagram.gresource.xml'),
  source_dir: join_paths(meson.project_source_root(), 'data'),
  c_name: 'gdiagram',
)

# --- Shared core static library ---
# Compiled ONCE and linked by the GUI, the LSP server, and the test suite so
# the ~180 core Vala files (+ the graphviz_compat C shim + generated config)
# are not recompiled per target. Meson forwards this library's generated
# internal .vapi, C headers, and dependencies to every Vala target that
# link_with's it (same-project propagation).
#
# Dependency set mirrors the (proven) gdiagram-lsp link line — everything the
# core public API references except gtksourceview, which is GUI-only.
gdiagram_core_lib = static_library('gdiagram-core',
  core_sources,
  c_sources,
  config_file,
  vala_args: shared_vala_args,
  c_args: shared_c_args,
  dependencies: [
    gtk4_dep,
    libadwaita_dep,
    gee_dep,
    libgvc_dep,
    librsvg_dep,
    cairo_dep,
    soup_dep,
    json_dep,
    libsecret_dep,
    math_dep,
  ],
  install: false,
)

# Dependency wrapper so consumers in OTHER directories (the test suite) pick up
# the generated gdiagram-core.h. include_directories('.') resolves to both
# src/ and its build-tree counterpart (build/src/), where valac emits the header.
gdiagram_core_dep = declare_dependency(
  link_with: gdiagram_core_lib,
  include_directories: include_directories('.'),
)

# --- GUI executable ---
# Only the UI sources compile here; core comes from the static library.
executable('gdiagram',
  ui_sources,
  resources,
  vala_args: shared_vala_args,
  c_args: shared_c_args,
  link_with: gdiagram_core_lib,
  dependencies: [
    gtk4_dep,
    libadwaita_dep,
    gtksourceview_dep,
    gee_dep,
    libgvc_dep,
    librsvg_dep,
    cairo_dep,
    soup_dep,
    json_dep,
    libsecret_dep,
    math_dep,
  ],
  install: true,
)

# --- LSP server executable ---
# Only the LSP sources compile here; core comes from the static library.
# Dependencies: no gtksourceview needed.
#
# Captured in a variable so the test suite can locate the built binary
# (tests/meson.build passes gdiagram_lsp_exe.full_path() to the integration test).
gdiagram_lsp_exe = executable('gdiagram-lsp',
  lsp_sources,
  vala_args: shared_vala_args,
  c_args: shared_c_args,
  link_with: gdiagram_core_lib,
  dependencies: [
    gtk4_dep,
    libadwaita_dep,
    gee_dep,
    libgvc_dep,
    librsvg_dep,
    cairo_dep,
    soup_dep,
    json_dep,
    libsecret_dep,
    math_dep,
  ],
  install: true,
)
