@startyaml
application:
  name: MyApp
  version: 2.1.0
  description: A sample application

server:
  host: 0.0.0.0
  port: 8080
  ssl: true
  timeout: 30

database:
  host: localhost
  port: 5432
  name: myapp_db
  pool:
    min: 2
    max: 10

features:
  - authentication
  - authorization
  - rate-limiting
  - caching
@endyaml
