@startuml
component [Application]
database [PostgreSQL] #LightBlue
database [Redis Cache] #Pink
file [Config File] #LightGreen
file [Logs] #Yellow

[Application] --> [PostgreSQL] : queries
[Application] --> [Redis Cache] : cache
[Application] ..> [Config File] : reads
[Application] ..> [Logs] : writes
@enduml
